# ============================================================
# Ettawa-Sense Backend — Environment Variables
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke Git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── MQTT Broker ──────────────────────────────────────────────
# Development (broker publik, tidak terenkripsi):
#   MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
#
# Production (HiveMQ Cloud, TLS — WAJIB untuk production):
#   Dapatkan URL setelah setup di https://www.hivemq.com/company/get-hivemq/
#   MQTT_BROKER_URL=mqtts://YOUR_CLUSTER_ID.s1.eu.hivemq.cloud:8883
#   MQTT_USERNAME=ettawa-app
#   MQTT_PASSWORD=your-strong-password
#
# PENTING: Harus sinkron dengan ESP32 config.h dan AI service main.py
MQTT_BROKER_URL=mqtts://YOUR_CLUSTER_ID.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=ettawa-app
MQTT_PASSWORD=your-strong-password

# ── Security ─────────────────────────────────────────────────
# Origins yang diizinkan untuk CORS (pisahkan dengan koma, tanpa spasi)
# Development: http://localhost:3000
# Production:  https://ettawa.yourdomain.com
ALLOWED_ORIGINS=https://ettawa.yourdomain.com,http://localhost:3000

# API key untuk REST endpoints dan Socket.io handshake.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Harus sama dengan NEXT_PUBLIC_API_KEY di frontend .env
API_KEY=change-me-to-random-32-char-hex-string

# ── InfluxDB ─────────────────────────────────────────────────
# Jika INFLUX_TOKEN dikosongkan, sistem otomatis pakai in-memory fallback.
# Untuk setup InfluxDB lokal:
#   1. Download: https://portal.influxdata.com/downloads/
#   2. Jalankan: influxd
#   3. Buka http://localhost:8086 → setup org & bucket
#   4. Generate API token → paste di sini
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=capratech
INFLUX_BUCKET=ettawa

# ── Frontend Origin ──────────────────────────────────────────
# Digunakan di banner startup log; duplikat dari ALLOWED_ORIGINS
FRONTEND_URL=https://ettawa.yourdomain.com
